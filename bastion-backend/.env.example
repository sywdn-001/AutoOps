# ============================================================================
# AutoOps 堡垒机 · 环境变量示例（完整清单）
#
# 用法：
#   1) 复制成 .env（这个文件留在版本库里当模板，.env 已被 .gitignore 忽略）：
#        cd bastion-backend
#        Copy-Item .env.example .env        # Windows PowerShell
#        cp .env.example .env               # Linux / macOS / Git Bash
#   2) 取消注释你要改的行，或直接新增  KEY=VALUE
#   3) 重启后端 `python run.py` 生效（app/config.py:load_dotenv() 只在启动时读一次）
#   4) 启动日志里的「已从 .env 载入 N 个变量」就是实际读到的条数
#
# 约定：
#   - 下面每一行都**默认被注释掉**，注释里的值就是代码里的默认值；
#     整份复制过去什么都不改，行为与不建 .env 完全一致。
#   - **真实环境变量优先**：命令行 / 服务管理器 / systemd 设置的值不会被 .env 覆盖
#     （load_dotenv() 只补充当前进程里没有的键）。
#   - 布尔值只认 1/0、true/false（0、false、False 视为关）；留空 = 用默认。
#   - 路径类默认值都是程序算好的绝对路径；只要你填了值就原样使用，
#     相对路径按**启动时的工作目录**解析（建议填绝对路径）。
#   - 密钥类（SECRET_KEY / JWT_SECRET / FERNET_KEY / GATEWAY_HOST_KEY）**留空最省事**：
#     首次启动自动生成并落到 instance/ 下；改这些值会让已有 JWT 与已存资产口令失效。
#
# English: every environment variable the project reads, commented out with its
# default. Copy to `.env`, uncomment what you need, restart the backend.
# Real environment variables win over `.env`.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. 数据目录与版本
# ----------------------------------------------------------------------------

# 数据根目录：数据库、密钥、录像、扩展模块都在它下面
# 默认 <bastion-backend>/instance；填相对路径会按启动时的当前目录解析，建议填绝对路径
# BASTION_INSTANCE_DIR=

# RDP 会话录像目录（默认 <INSTANCE_DIR>/rdp_recordings）
# BASTION_RDP_RECORDING_DIR=

# 已安装的扩展模块目录（每个模块一个子目录，文件系统即真相；默认 <INSTANCE_DIR>/modules）
# BASTION_MODULES_DIR=

# 安装前预览会话目录（upload-check 之后暂存包与截图，30 分钟 TTL；默认 <INSTANCE_DIR>/module-previews）
# BASTION_MODULE_PREVIEW_DIR=

# 后端版本号：扩展模块的 minBastionVersion 用它做兼容校验；界面不展示版本
# BASTION_APP_VERSION=1.0.0


# ----------------------------------------------------------------------------
# 2. 密钥（留空 = 首次启动自动生成到 instance/；改值会让旧 JWT / 旧口令失效）
# ----------------------------------------------------------------------------

# Flask SECRET_KEY，同时也是默认的 JWT 签名密钥；自动生成到 instance/secret.key
# BASTION_SECRET_KEY=

# 单独指定 JWT 签名密钥；留空则复用 SECRET_KEY
# BASTION_JWT_SECRET=

# 资产口令 / 私钥的对称加密密钥（Fernet）；自动生成到 instance/fernet.key
# 丢失 = 已保存的资产口令无法解密，请随 instance/ 一起备份
# BASTION_FERNET_KEY=

# 登录令牌有效期（小时）
# BASTION_TOKEN_HOURS=12


# ----------------------------------------------------------------------------
# 3. 数据库
# ----------------------------------------------------------------------------

# 默认 SQLite：sqlite:///<INSTANCE_DIR>/bastion.db（绝对路径，随 INSTANCE_DIR 走）
# 指向别的库时注意 SQLite 的三斜杠写法，例如 sqlite:///D:/data/bastion.db
# 换成 PostgreSQL 等外部库需要自备驱动，并写成 postgresql://user:pass@host/db
# BASTION_DB_URI=


# ----------------------------------------------------------------------------
# 4. Web 控制台（Flask 主进程）
# ----------------------------------------------------------------------------

# 监听地址与端口；前端 `npm run dev` 的代理默认也指向 5000
# BASTION_HOST=0.0.0.0
# BASTION_PORT=5000

# 跨域白名单，逗号分隔；* = 允许所有来源（生产建议写具体域名）
# BASTION_CORS_ORIGINS=*

# 前端构建产物目录（ant-design-pro/dist）；不存在时 Flask 只提供 /api/*
# BASTION_FRONTEND_DIST=../ant-design-pro/dist

# 0 = 不托管前端（纯 API 模式，前端交给 nginx / dev server）
# BASTION_SERVE_FRONTEND=1

# 内置管理员：只在**首次建库**时创建，之后请在页面上改密
# BASTION_ADMIN_USERNAME=admin
# BASTION_ADMIN_PASSWORD=admin123

# 登录安全：连续失败几次锁定、锁定多少分钟
# BASTION_LOGIN_MAX_FAILURES=5
# BASTION_LOGIN_LOCK_MINUTES=15


# ----------------------------------------------------------------------------
# 5. WebRDP 会话录像（边录边传）
# ----------------------------------------------------------------------------

# 单个录像文件上限（MB）；请求体上限自动 = 本值 + 8MB
# BASTION_RDP_RECORDING_MAX_MB=512

# 单个分片请求上限（MB）；前端每 5 秒发一片，实测 1~2MB
# BASTION_RDP_RECORDING_CHUNK_MAX_MB=32

# 小于这个字节数认为没录到东西（纯黑 / 刚开就断），转正时丢弃
# BASTION_RDP_RECORDING_MIN_BYTES=4096

# 这么久没分片上报就认为窗口已关闭，下次列录像 / 开新会话时自动收口
# BASTION_RDP_UPLOAD_STALE_SECONDS=45


# ----------------------------------------------------------------------------
# 6. SSH 网关（运维人员 ssh 连 2222 进来选机器）
# ----------------------------------------------------------------------------

# BASTION_GATEWAY_ENABLED=1
# BASTION_GATEWAY_HOST=0.0.0.0
# BASTION_GATEWAY_PORT=2222

# 网关服务端主机私钥；留空自动生成到 <INSTANCE_DIR>/gateway_host_rsa.key
# BASTION_GATEWAY_HOST_KEY=

# 客户端看到的 SSH 版本串
# BASTION_GATEWAY_SERVER_VERSION=SSH-2.0-BastionGW_1.0

# 允许口令认证 / 允许公钥认证（公钥需先在「身份与权限 → 用户」登记）
# BASTION_GATEWAY_ALLOW_PASSWORD=1
# BASTION_GATEWAY_ALLOW_PUBKEY=1

# 每个账号最多几个并发会话
# BASTION_GATEWAY_MAX_SESSIONS=5

# 连上后多少秒内必须完成认证（防挂空连接）
# BASTION_GATEWAY_AUTH_TIMEOUT=120

# 登录横幅（支持中文；值里有 = 时用引号包起来）
# BASTION_GATEWAY_BANNER="=== AutoOps 堡垒机 审计网关 ==="


# ----------------------------------------------------------------------------
# 7. 会话与命令审计
# ----------------------------------------------------------------------------

# 单条命令最长等待输出（秒）
# BASTION_COMMAND_TIMEOUT=60

# 单条命令写进审计的输出上限（字节，默认 256KB）
# BASTION_MAX_OUTPUT_BYTES=262144

# 会话空闲超时（秒）；0 = 不限制
# BASTION_SESSION_IDLE_TIMEOUT=1800

# 终端回放的事件条数上限
# BASTION_TRANSCRIPT_MAX_EVENTS=200000


# ----------------------------------------------------------------------------
# 8. SSH 客户端行为（堡垒机去连目标机时用）
# ----------------------------------------------------------------------------

# BASTION_SSH_CONNECT_TIMEOUT=15
# BASTION_SSH_BANNER_TIMEOUT=20
# BASTION_SSH_KEEPALIVE=30


# ----------------------------------------------------------------------------
# 9. AI 运维（DeepSeek，可选；Key 只放 .env，绝不入库）
# ----------------------------------------------------------------------------

# 总开关：0 = /api/ai/* 一律拒绝，侧边栏也不显示「AI 运维」
# AI_ENABLED=1

# ★ 唯一真正需要你填的一项。控制台：https://platform.deepseek.com
# 不填时 /api/ai/chat 直接 400 AI_NOT_CONFIGURED（不会先 200 再在流里报错）
DEEPSEEK_API_KEY=

# 兼容 OpenAI 协议的中转地址也可以填这里
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：deepseek-flash（快、便宜，默认）或 deepseek-v4-pro
# AI_MODEL=deepseek-flash

# 单次上游请求超时（秒）
# AI_REQUEST_TIMEOUT=120

# 单轮生成上限（推理模型会先吃 reasoning token，给小了会空响应）
# AI_MAX_TOKENS=8192

# 一个回合内最多几轮「模型要工具 → 执行 → 回灌」
# 运行时会优先用『系统设置 → 参数设置 → AI 任务最大调用轮数』，这里只是兜底
# AI_MAX_TOOL_ROUNDS=8

# 敏感操作确认票据的有效期（秒）
# AI_CONFIRM_TTL=300

# 回灌给模型的历史消息条数上限
# AI_HISTORY_LIMIT=40

# 单次工具结果回灌给模型的最大字符数（防止上下文爆炸）
# AI_TOOL_RESULT_LIMIT=8000


# ----------------------------------------------------------------------------
# 10. RDP 网关扩展模块（可选）
#     这些是**模块进程 / 网关 exe** 读的变量；模块启动 exe 时会自动注入，
#     正常不需要手填。只有单独跑 exe、或把网关装到别的机器上时才用得上。
# ----------------------------------------------------------------------------

# 网关监听端口（mstsc 连这个端口）
# RDP_GATEWAY_PORT=4489

# 后端地址：BASTION_API_BASE 优先，其次 BASTION_API_PORT，最后默认 127.0.0.1:5000
# BASTION_API_BASE=http://127.0.0.1:5000
# BASTION_API_PORT=5000

# 后端 API 前缀；装成模块后是 /api/modules/rdp-gateway/api
# BASTION_API_PREFIX=/api/modules/rdp-gateway/api

# 自定义网关 exe 路径（优先级高于模块包内的 bin/）
# BASTION_RDP_GATEWAY_BIN=

# 网关日志级别
# RUST_LOG=info


# ----------------------------------------------------------------------------
# 11. 前端开发（ant-design-pro，`npm run dev` 时读）
# ----------------------------------------------------------------------------

# 选 config/proxy.ts 里的哪套代理：dev / test / pre
# UMI_ENV=dev

# 开发代理目标（/api/** 与 /socket.io/** 转发到这里）
# BASTION_API=http://127.0.0.1:5000


# ----------------------------------------------------------------------------
# 12. 本地校验脚本与 CI（bastion-backend/tools/* 与 GitHub Actions）
# ----------------------------------------------------------------------------

# 脚本登录用的管理员账号
# BASTION_ADMIN=admin
# BASTION_ADMIN_USERNAME=admin
# BASTION_ADMIN_PASSWORD=admin123

# 脚本访问的站点地址 / CDP 调试端口（截图类脚本用）
# BASTION_BASE=http://127.0.0.1:5000
# BASTION_CDP=http://127.0.0.1:9222
# CU_BASE=http://127.0.0.1:5000

# 截图输出目录（默认 docs/screenshots）
# BASTION_SHOTS_DIR=

# 终端 / 网关自检脚本里的示例主机与账号名
# BASTION_CONSOLE_HOST=e2e-demo-01
# BASTION_CONSOLE_WHOAMI=opsadmin

# CI 强制 Python 用 UTF-8 输出（英文 runner 的 cp1252 会让打包脚本崩）
# PYTHONUTF8=1
# PYTHONIOENCODING=utf-8

# GitHub Actions 会自动注入 CI=true（umi 配置里会透传 process.env.CI），本地不用填
# CI=
