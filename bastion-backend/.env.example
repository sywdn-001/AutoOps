# AutoOps 堡垒机 · 环境变量示例
# 复制为 .env 后填写真实值（.env 不进版本库）

# --- AI 运维（AIOps）：DeepSeek ---
# 控制台 -> https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
# 兼容 OpenAI 协议的服务地址；默认官方地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型：deepseek-flash（快、便宜，默认）或 deepseek-v4-pro
AI_MODEL=deepseek-flash
# 关掉 AI 运维（0/false）
AI_ENABLED=1
