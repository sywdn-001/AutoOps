/node_modules/
ant-design-pro/dist/
ant-design-pro/src/.umi/
**/__pycache__/
*.py[cod]
.venv/
venv/

# ── 运行时状态与密钥（数据是状态，不是代码；密钥更不能入库）──
bastion-backend/instance/
bastion-backend/.env

# ── 打包产物（本地跑 `python -m PyInstaller packaging/autoops.spec` 会生成）──
bastion-backend/build/

